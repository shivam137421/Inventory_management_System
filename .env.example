# StockPilot Environment Configuration Template
# Copy this file to .env or configure these variables in your active terminal session.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO GIT.

# Database Configuration
DB_URL=jdbc:mysql://127.0.0.1:3306/inventory?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Resend Email Integration (Decision D2)
# If left blank, the application automatically falls back to ConsoleEmailService for local testing.
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM=onboarding@resend.dev

# Frontend & Application URLs
PORT=8080
FRONTEND_BASE_URL=http://localhost:4200

# Security Tokens
JWT_SECRET=development_placeholder_jwt_secret_key_minimum_256_bits_length!
